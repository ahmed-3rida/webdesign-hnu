{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install needed: site/ is prebuilt'",
  "buildCommand": "echo 'no build needed: site/ is prebuilt'",
  "outputDirectory": "site",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.(png|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
